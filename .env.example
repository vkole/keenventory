# Optional persistent SQLite directory; default: ./data
# KEENVENTORY_DATA_DIR=C:/Keenventory/data

# Private S3-compatible product image storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Server-only Shopify Admin API credentials
SHOPIFY_SHOP=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Accounts: use your HTTPS origin in production and a random 32+ character secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Account verification, invitations, owner activation and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: reject passwords found by the Pwned Passwords hash-prefix service.
KEENVENTORY_CHECK_BREACHED_PASSWORDS=false
